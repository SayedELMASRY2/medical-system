# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=materna_user
POSTGRES_PASSWORD=materna_password
POSTGRES_DB=materna_db

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI & LLM Provider Keys (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
COHERE_API_KEY=...

# Models (OpenRouter Model IDs)
MODEL_SUPERVISOR=openai/gpt-4o-mini
MODEL_TIMELINE=openai/gpt-4o-mini
MODEL_RAG=openai/gpt-4o-mini
MODEL_TRIAGE=openai/gpt-4o

# Frontend URL for CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
